{
  "name": "agentqa",
  "version": "1.0.0",
  "description": "AgentQA - Autonomous Web Application Testing Platform. Auto-discover, generate, and execute Playwright tests for any web application.",
  "main": "dist/index.js",
  "bin": {
    "agentqa": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsc -p tsconfig.cli.json && next build",
    "start": "next start",
    "build:cli": "tsc -p tsconfig.cli.json",
    "start:cli": "node dist/cli/index.js",
    "dev:cli": "ts-node src/cli/index.ts",
    "ui": "ts-node src/cli/index.ts ui",
    "test": "playwright test",
    "lint": "next lint",
    "clean": "rm -rf dist generated reports .next",
    "discover": "ts-node src/cli/index.ts discover",
    "generate": "ts-node src/cli/index.ts generate",
    "execute": "ts-node src/cli/index.ts execute",
    "report": "ts-node src/cli/index.ts report"
  },
  "keywords": [
    "testing",
    "automation",
    "playwright",
    "e2e",
    "web-testing",
    "test-generation",
    "angular",
    "react",
    "nextjs"
  ],
  "author": "AgentQA Team",
  "license": "MIT",
  "dependencies": {
    "@playwright/test": "^1.40.0",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^11.1.0",
    "csv-parse": "^5.5.2",
    "csv-stringify": "^6.4.4",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "handlebars": "^4.7.8",
    "inquirer": "^8.2.6",
    "next": "^16.0.6",
    "open": "^8.4.2",
    "ora": "^5.4.1",
    "playwright": "^1.40.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
