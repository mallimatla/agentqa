# AgentQA Environment Variables

# ===========================================
# Firebase Configuration (Client-side)
# ===========================================
# Get these from Firebase Console > Project Settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ===========================================
# Firebase Admin SDK (Server-side)
# ===========================================
# Option 1: Full credentials JSON (recommended for Vercel)
# Go to Firebase Console > Project Settings > Service Accounts > Generate new private key
# Stringify the JSON and set as FIREBASE_ADMIN_CREDENTIALS
FIREBASE_ADMIN_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"..."}

# Option 2: Individual fields (alternative)
# FIREBASE_ADMIN_PROJECT_ID=your_project_id
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ===========================================
# Test credentials (used when running tests)
# ===========================================
TEST_USERNAME=
TEST_PASSWORD=
TEST_EMAIL=
TEST_TOKEN=

# Base URL for testing
BASE_URL=http://localhost:3000

# ===========================================
# Optional Settings
# ===========================================
# OpenAI API Key for AI-powered test suggestions
# OPENAI_API_KEY=sk-...

# Logging
LOG_LEVEL=info

# Node environment
NODE_ENV=development
